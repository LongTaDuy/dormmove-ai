# ---- App ----
APP_NAME=DormMove AI
APP_ENV=development
LOG_LEVEL=info

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# SQLite by default; swap for any SQLAlchemy-compatible URL later.
DATABASE_URL=sqlite:///./dormmove.db

# SQLite session memory database path (created automatically).
DORMMOVE_SQLITE_PATH=local_data/dormmove.sqlite3

# ---- Optional Redis checkpointing (LangGraph) ----
# Leave blank to disable Redis and use in-process/SQLite checkpointing.
REDIS_URL=

# ---- Model router (mock is default — no API key required) ----
# Provider: mock | openai
DORMMOVE_MODEL_PROVIDER=mock
DORMMOVE_LLM_MODEL=gpt-4o-mini
DORMMOVE_LLM_FALLBACK_MODEL=gpt-4o-mini
OPENAI_API_KEY=
DORMMOVE_LLM_TIMEOUT_SECONDS=20
DORMMOVE_LLM_MAX_RETRIES=2
DORMMOVE_MAX_MODEL_CALLS_PER_SESSION=20
DORMMOVE_MAX_ESTIMATED_COST_PER_SESSION_USD=0.25
DORMMOVE_ESTIMATED_COST_PER_CALL_USD=0.002
DORMMOVE_ALLOW_LLM_FALLBACK=true

# Legacy aliases (optional)
MODEL_PROVIDER=mock
MODEL_NAME=mock-default

# Other provider keys (not used in current milestone)
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
