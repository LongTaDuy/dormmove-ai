# ---- App ----
APP_NAME=DormMove AI
APP_ENV=development
LOG_LEVEL=info

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# SQLite by default; swap for any SQLAlchemy-compatible URL later.
DATABASE_URL=sqlite:///./dormmove.db

# SQLite session memory database path (created automatically).
DORMMOVE_SQLITE_PATH=local_data/dormmove.sqlite3

# ---- Optional Redis checkpointing (LangGraph) ----
# Leave blank to disable Redis and use in-process/SQLite checkpointing.
REDIS_URL=

# ---- Model router ----
# Provider: mock | openai | gemini | bedrock
MODEL_PROVIDER=mock
MODEL_NAME=mock-default

# Provider API keys (only needed when MODEL_PROVIDER != mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
